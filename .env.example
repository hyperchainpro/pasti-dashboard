# ─────────────────────────────────────────────────────────────
# PASTI Dashboard - Environment Variables
# Copy this file to `.env` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# ── DATABASE (Neon Postgres) ─────────────────────────────────
# Get this from https://console.neon.tech → your project → "Connection string"
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://pasti_user:xxxxxxxxxx@ep-xxx-pooler.region.aws.neon.tech/pasti?sslmode=require"

# ── OPENROUTER (LLM Agent Simulation) ────────────────────────
# Get this from https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Model: free tier options
#   - "meta-llama/llama-3.2-3b-instruct:free"
#   - "google/gemini-2.0-flash-exp:free"
#   - "qwen/qwen-2.5-7b-instruct:free"
# Paid options (better reasoning, recommended for demo):
#   - "anthropic/claude-3.5-haiku"
#   - "openai/gpt-4o-mini"
OPENROUTER_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# Optional: for OpenRouter analytics dashboard
OPENROUTER_SITE_URL="https://pasti-v2.vercel.app"
OPENROUTER_SITE_NAME="PASTI Dashboard"

# ── TELEGRAM (Production: real approval flow) ────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="PASTI"
NEXT_PUBLIC_APP_VERSION="2.0.0"

# ── NextAuth.js (Authentication) ────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Cloudflare Turnstile (Captcha — free, no signup fees) ────
# Get at https://dash.cloudflare.com → Turnstile
# Optional — if not set, dev mode auto-bypasses captcha
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── SMTP (for forgot-password email) ─────────────────────────
# Optional — if not set, reset link is logged to server console
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
